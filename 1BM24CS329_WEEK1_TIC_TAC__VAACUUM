        "# Goal-Based Agent - Vacuum Cleaner\n",
        "\n",
        "def goal_based_agent(rooms, location):\n",
        "    # Goal: Both rooms should be clean\n",
        "\n",
        "    # If current room is dirty, clean it\n",
        "    if rooms[location] == \"Dirty\":\n",
        "        return \"Suck\"\n",
        "    if location == \"A\" and rooms[\"B\"] == \"Dirty\":\n",
        "        return \"Move Right\"\n",
        "\n",
        "    if location == \"B\" and rooms[\"A\"] == \"Dirty\":\n",
        "        return \"Move Left\"\n",
        "\n",
        "    if rooms[\"A\"] == \"Clean\" and rooms[\"B\"] == \"Clean\":\n",
        "        return \"Goal Achieved\"\n",
        "\n",
        "\n",
        "def run_goal_based_agent(room_A, room_B, start_location):\n",
        "    rooms = {\n",
        "        \"A\": room_A,\n",
        "        \"B\": room_B\n",
        "    }\n",
        "\n",
        "    location = start_location\n",
        "\n",
        "    print(\"Initial State:\")\n",
        "    print(\"Room A:\", rooms[\"A\"])\n",
        "    print(\"Room B:\", rooms[\"B\"])\n",
        "    print(\"Starting Location:\", location)\n",
        "    print()\n",
        "\n",
        "    while True:\n",
        "\n",
        "        action = goal_based_agent(rooms, location)\n",
        "\n",
        "        print(\"Location:\", location)\n",
        "        print(\"Room A:\", rooms[\"A\"])\n",
        "        print(\"Room B:\", rooms[\"B\"])\n",
        "        print(\"Action:\", action)\n",
        "        print()\n",
        "\n",
        "        if action == \"Suck\":\n",
        "            rooms[location] = \"Clean\"\n",
        "\n",
        "        elif action == \"Move Right\":\n",
        "            location = \"B\"\n",
        "\n",
        "        elif action == \"Move Left\":\n",
        "            location = \"A\"\n",
        "\n",
        "        elif action == \"Goal Achieved\":\n",
        "            break\n",
        "\n",
        "    print(\"Goal achieved!\")\n",
        "    print(\"Final State:\")\n",
        "    print(\"Room A:\", rooms[\"A\"])\n",
        "    print(\"Room B:\", rooms[\"B\"])\n",
        "\n",
        "\n",
        "run_goal_based_agent(\"Dirty\", \"Dirty\", \"A\")\n"
