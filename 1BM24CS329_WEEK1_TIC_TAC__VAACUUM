        "# Simple Reflex\n",
        "\n",
        "def reflex_agent(location, status):\n",
        "    if status == \"Dirty\":\n",
        "        return \"Suck\"\n",
        "    elif location == \"A\":\n",
        "        return \"Move Right\"\n",
        "    elif location == \"B\":\n",
        "        return \"Move Left\"\n",
        "\n",
        "\n",
        "def run_reflex_agent(room_A, room_B, start_location):\n",
        "    rooms = {\n",
        "        \"A\": room_A,\n",
        "        \"B\": room_B\n",
        "    }\n",
        "\n",
        "    location = start_location\n",
        "\n",
        "    print(\"Initial State:\")\n",
        "    print(\"Room A:\", rooms[\"A\"])\n",
        "    print(\"Room B:\", rooms[\"B\"])\n",
        "    print(\"Starting Location:\", location)\n",
        "    print()\n",
        "\n",
        "    while rooms[\"A\"] == \"Dirty\" or rooms[\"B\"] == \"Dirty\":\n",
        "\n",
        "        status = rooms[location]\n",
        "\n",
        "        action = reflex_agent(location, status)\n",
        "\n",
        "        print(\"Location:\", location)\n",
        "        print(\"Action:\", action)\n",
        "\n",
        "        if action == \"Suck\":\n",
        "            rooms[location] = \"Clean\"\n",
        "\n",
        "        elif action == \"Move Right\":\n",
        "            location = \"B\"\n",
        "\n",
        "        elif action == \"Move Left\":\n",
        "            location = \"A\"\n",
        "\n",
        "        print()\n",
        "\n",
        "    print(\"Both rooms are clean!\")\n",
        "    print(\"Final State:\")\n",
        "    print(\"Room A:\", rooms[\"A\"])\n",
        "    print(\"Room B:\", rooms[\"B\"])\n",
        "\n",
        "\n",
        "run_reflex_agent(\"Dirty\", \"Dirty\", \"A\")\n"
      ],
